<%# The form here creates any of the three kinds of pool, so the page cannot be titled for
    one of them. It was "New Savings Pool" back when a pool could only be a savings goal. %>
<%= page_header(
    title: "New Pool",
    subtitle: "A bank account, a budget envelope refilled each period, or a savings goal",
    breadcrumbs: [
      { label: "Pools", url: pools_path },
      { label: "New Pool" }
    ]
) %>

<div class="max-w-2xl mx-auto">
  <%= render "form", pool: @pool %>
</div>
