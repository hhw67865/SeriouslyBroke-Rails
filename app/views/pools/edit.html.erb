<%# Edit Savings Pool Page using standardized page header %>
<%= page_header(
    title: "Edit Savings Pool",
    subtitle: "Update details for #{@pool.name}",
    breadcrumbs: [
      { label: "Savings Pools", url: pools_path },
      { label: @pool.name, url: pool_path(@pool) },
      { label: "Edit" }
    ]
) %>

<div class="max-w-2xl mx-auto">
  <%= render "form", pool: @pool %>
</div>
