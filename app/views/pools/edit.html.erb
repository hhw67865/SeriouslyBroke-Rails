<%# This is where Home's "give it an account" sends the user, for a pool of any kind — so
    the title says "Pool", not "Savings Pool". %>
<%= page_header(
    title: "Edit Pool",
    subtitle: "Update details for #{@pool.name}",
    breadcrumbs: [
      { label: "Pools", url: pools_path },
      { label: @pool.name, url: pool_path(@pool) },
      { label: "Edit" }
    ]
) %>

<div class="max-w-2xl mx-auto">
  <%= render "form", pool: @pool %>
</div>
