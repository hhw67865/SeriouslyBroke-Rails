<%# Pool form. A pool is a bank ACCOUNT, a budget ENVELOPE or a savings GOAL, and the last
    two live inside an account. Local: `pool`.

    This form used to render `name`, `target_amount` and `start_date` alone, with a submit
    button reading "Create Savings Pool". `pools.pool_type` defaulted to 2 (savings) and
    `account_id` is nullable, so every pool anybody could make here was an account-less
    savings goal — while Home told those same users, in three separate places, to give their
    pools an account. There was no field on earth to do it with. `pool_params` has permitted
    `pool_type`, `account_id` and `priority` since Plan 2a; this is the form catching up.

    THE BLANK OPTION IS THE ACCOUNT'S OWN ANSWER AND NOBODY ELSE'S (plan 3, task 6). It used to
    read "No account — nothing can fund this pool", which was a real state a goal could be left
    in; `Pool#account_matches_pool_type` now requires an account for every envelope and goal, and
    a CHECK constraint requires it again at the database, so the only pool that may leave this
    blank is a bank account. Left as it was, the select offered a choice that is refused on
    submit for two of the three types. `pools.pool_type` now defaults to 1 (budget) too, so a
    form opened for a brand-new pool starts on "Budget envelope". %>
<div class="bg-white shadow-sm rounded border border-gray-100 p-6">
  <%= simple_form_for pool, html: { class: "space-y-6" } do |f| %>
    <%= f.error_notification %>
    <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

    <%# Name %>
    <div>
      <%= f.input :name,
          label: "Pool Name",
          input_html: {
            placeholder: "e.g., Checking, Groceries, Emergency Fund"
          },
          hint: "What this is called on Home" %>
    </div>

    <%# What kind of pool. First, because it decides what every field below it means. %>
    <div>
      <%= f.input :pool_type,
          as: :select,
          collection: [
            ["Bank account", "account"],
            ["Budget envelope", "budget"],
            ["Savings goal", "savings"]
          ],
          include_blank: false,
          label: "What kind of pool is this?",
          hint: "An account holds real money. An envelope is refilled out of an account every " \
                "period. A goal accumulates inside an account toward a target." %>
    </div>

    <%# Which account holds it.
        Said plainly rather than rendered as an empty select: a user with no accounts yet is
        not looking at a field they forgot to fill in, they are looking at a step they have
        not taken. An empty dropdown is the same dead end Home was sending them to. %>
    <% accounts = assignable_accounts_for(pool) %>
    <div>
      <% if accounts.any? %>
        <%= f.association :account,
            collection: accounts,
            label_method: :name,
            value_method: :id,
            include_blank: "None — this pool IS a bank account",
            label: "Account it sits inside",
            hint: "Envelopes and goals must name one. A bank account leaves this blank — it is " \
                  "where the money already is." %>
      <% elsif pool.user.pools.accounts.exists? %>
        <%# The collection is empty and yet the user does have an account: the only one they
            have is this pool. Keyed off `accounts.any?` alone, that user was told on their own
            account's edit page that they had no bank accounts and should make this one — a
            bank account — a bank account. A <p>, not a bare <label>, since there is no field
            below it to label. %>
        <p class="form-label">Account it sits inside</p>
        <div class="rounded border border-gray-200 bg-gray-50 p-4">
          <p class="text-sm text-gray-600">
            <strong>This is your only bank account.</strong>
            An account sits inside nothing — it is where the money already is. Envelopes and goals
            go inside it, not the other way round.
          </p>
        </div>
      <% else %>
        <label class="form-label">Account it sits inside</label>
        <div class="rounded border border-status-warning bg-status-warning-light p-4">
          <p class="text-sm text-status-warning">
            <strong>You have no bank accounts yet.</strong>
            Nothing can fund an envelope or a goal until an account holds it — so make this one a
            <strong>Bank account</strong> above, then come back and put your envelopes inside it.
          </p>
        </div>
      <% end %>
    </div>

    <%# Funding order. %>
    <div>
      <%= f.input :priority,
          as: :integer,
          label: "Funding Priority",
          input_html: { min: 0, step: 1 },
          hint: "Lower numbers are funded first when a period's money runs out. Ties are broken " \
                "by name." %>
    </div>

    <%# Target Amount %>
    <div>
      <%= f.input :target_amount,
          as: :decimal,
          label: "Target Amount",
          input_html: {
            placeholder: "0.00",
            step: 0.01,
            min: 0.01
          },
          hint: "Required on a savings goal — the figure you are saving toward. On an account it " \
                "is your buffer marker, a health line and never a cap. Optional on an envelope." %>
    </div>

    <%# Start Date %>
    <div>
      <%= f.input :start_date,
          as: :date,
          html5: true,
          label: "Start Date",
          hint: "Where a savings goal's timeline begins. It does not filter the balance." %>
    </div>

    <%# Progress Indicator (for existing goals) %>
    <% if pool.persisted? && pool.target_amount.present? %>
      <div class="bg-gray-50 rounded p-4 border-l-4 border-brand">
        <h4 class="text-sm font-medium text-gray-900 mb-2">Current Progress</h4>
        <% calculator = pool.calculator %>
        <% progress = calculator.progress_percentage %>
        <% current_balance = calculator.current_balance %>

        <div class="flex justify-between text-sm text-gray-600 mb-2">
          <span>Progress toward goal</span>
          <span class="font-medium"><%= progress %>%</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden mb-3">
          <div class="h-2 rounded-full bg-brand transition-all duration-300"
               style="width: <%= [progress, 100].min %>%;"></div>
        </div>

        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-gray-500">Current Balance:</span>
            <span class="font-medium <%= current_balance >= 0 ? "text-status-success" : "text-status-danger" %>">
              <%= number_to_currency(current_balance) %>
            </span>
          </div>
          <div>
            <span class="text-gray-500">Remaining:</span>
            <span class="font-medium text-brand">
              <%= number_to_currency(calculator.remaining_amount) %>
            </span>
          </div>
        </div>
      </div>
    <% end %>

    <%# Auto-create categories (only on new records) %>
    <% unless pool.persisted? %>
      <div class="bg-gray-50 rounded p-4 border border-gray-200">
        <h4 class="text-sm font-medium text-gray-900 mb-1">Create categories automatically (optional)</h4>
        <p class="text-sm text-gray-600 mb-3">Save time by creating linked categories now. Each category will be named after this pool.</p>

        <%# ONE BOX, NOT TWO (plan 3, task 5). The second created a SAVINGS category, and there is
            no such type: a pool is filled by moving money into it, and the category a pool needs is
            the one that spends OUT of it. %>
        <div class="space-y-2">
          <%= f.input :create_expense_category,
              as: :boolean,
              label: "Create an expense category" %>
        </div>
      </div>
    <% end %>

    <%# How it works %>
    <div class="bg-status-info-light rounded p-4 border border-status-info">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <%= heroicon "information-circle", options: { class: "h-5 w-5 text-status-info" } %>
        </div>
        <div class="ml-3">
          <h4 class="text-sm font-medium text-status-info">How it works</h4>
          <div class="mt-1 text-sm text-status-info">
            <ul class="list-disc list-inside space-y-1">
              <li>Money arrives in an <strong>account</strong>, then fills the pools inside it in priority order</li>
              <li>A pool with no account can never be funded — Home says so on every one</li>
              <li>Connect categories to a pool to track what it spends</li>
              <li>Money <strong>arrives</strong> in a pool by being moved into it; connected categories <strong>spend</strong> it</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <%# Form Actions %>
    <div class="flex flex-col sm:flex-row sm:justify-end gap-3 pt-6 border-t border-gray-200">
      <%= link_to "Cancel",
                  pools_path,
                  class: "btn btn-secondary" %>

      <%= f.submit pool.persisted? ? "Update Pool" : "Create Pool",
          class: "btn btn-primary" %>
    </div>

  <% end %>
</div>
