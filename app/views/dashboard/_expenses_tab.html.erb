<% show_total = params[:show_total] == "true" %>
<%# THE TWO LANES SPENDING COMES OUT OF (plan 3, task 4, decision 6). The sections used to be
    "Monthly Budget" (spending measured against a category cap) and "Pool-Covered Spending"
    (spending "funded by your savings pools"). Neither noun survives the cutover: there are no
    caps, and an envelope is not a savings pool. What the split actually is — and always was, once
    Task 3 re-pointed it — is whether the category's money sat in an ENVELOPE before it was spent
    or came straight out of an ACCOUNT.

    GONE WITH THE CAP: the "Budget" line drawn across the chart, the Monthly/YTD Budget stat card,
    the per-row "$650.00 / $500.00" and "+$150.00 over" clauses, and the column total that paired
    spending with a cap. Each read `CategoryCalculator#monthly_budget_rate`, which read
    `budgets.category_id` — nil on every row.

    `:expenses_v11` — bumped so nothing cached under the old shape survives.
%>
<% cache [current_user, selected_date, current_period, show_total, :expenses_v11] do %>

<%# === OUT OF THE BUFFER === %>
<section class="mb-12">
  <div class="border-l-4 border-terracotta pl-4 mb-6">
    <h2 class="text-xl font-semibold text-gray-900">Out of the Buffer</h2>
    <p class="text-sm text-gray-500">Spending from categories with no envelope — nothing reserved this money before you spent it</p>
  </div>

  <%# Running-total chart %>
  <div class="mb-8">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <h3 class="text-lg font-medium text-gray-900"><%= @presenter.ytd? ? "YTD Buffer Spending" : "Buffer Spending" %></h3>
      <%= link_to reports_path(tab: @tab, period: params[:period], show_total: show_total ? "false" : "true"),
          class: "inline-flex items-center gap-2 px-3 py-1 text-xs font-medium rounded border #{show_total ? "border-brand bg-brand/10 text-brand-dark" : "border-gray-300 bg-white text-gray-500 hover:bg-gray-50"} transition" do %>
        <%= heroicon show_total ? "eye-slash" : "eye", options: { class: "h-3.5 w-3.5" } %>
        <%= show_total ? "Hide Total" : "Show Total" %>
      <% end %>
    </div>
    <div class="bg-gray-50 rounded p-4">
      <% if @presenter.expenses_chart_data.any? %>
        <%= line_chart @presenter.expenses_chart_data,
            curve: false,
            points: false,
            prefix: "$ ",
            colors: @presenter.expenses_chart_colors %>
      <% else %>
        <p class="text-gray-500 text-center py-8">No buffer spending <%= period_time_label %></p>
      <% end %>
    </div>
  </div>

  <%# Buffer stats %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
    <div class="bg-gray-50 rounded p-4">
      <p class="text-sm text-gray-500"><%= @presenter.ytd? ? "YTD Tracked Buffer Spending" : "Tracked Buffer Spending" %></p>
      <p class="text-2xl font-semibold text-brand-dark"><%= number_to_currency(@presenter.total_tracked_buffer_expenses) %></p>
    </div>
    <div class="bg-gray-50 rounded p-4">
      <p class="text-sm text-gray-500"><%= @presenter.ytd? ? "YTD Total Buffer Spending" : "Total Buffer Spending" %></p>
      <p class="text-2xl font-semibold text-terracotta"><%= number_to_currency(@presenter.total_buffer_expenses) %></p>
    </div>
  </div>

  <%# Buffer breakdown %>
  <% buffer_categories = @presenter.buffer_categories_breakdown %>
  <% if buffer_categories.any? %>
    <div class="space-y-3">
      <% buffer_categories.each do |cat| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-100 gap-2">
          <%= link_to cat[:name], category_path(cat[:id]), class: "text-gray-700 hover:text-brand-dark truncate" %>
          <span class="font-medium text-gray-900 shrink-0"><%= number_to_currency(cat[:amount]) %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-sm">No buffer spending <%= period_time_label %></p>
  <% end %>
</section>

<%# === OUT OF AN ENVELOPE === %>
<section class="mb-12">
  <div class="border-l-4 border-dusty-teal pl-4 mb-6">
    <h2 class="text-xl font-semibold text-gray-900">Out of an Envelope</h2>
    <p class="text-sm text-gray-500">Spending from categories whose money was moved into an envelope or a goal before it was spent</p>
  </div>

  <%# Envelope stats %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-gray-50 rounded p-4">
      <p class="text-sm text-gray-500"><%= @presenter.ytd? ? "YTD Tracked Envelope Spending" : "Tracked Envelope Spending" %></p>
      <p class="text-2xl font-semibold text-brand-dark"><%= number_to_currency(@presenter.total_tracked_envelope_expenses) %></p>
    </div>
    <div class="bg-gray-50 rounded p-4">
      <p class="text-sm text-gray-500"><%= @presenter.ytd? ? "YTD Total Envelope Spending" : "Total Envelope Spending" %></p>
      <p class="text-2xl font-semibold text-terracotta"><%= number_to_currency(@presenter.total_envelope_expenses) %></p>
    </div>
  </div>

  <%# Envelope breakdown %>
  <% envelope_categories = @presenter.envelope_categories_breakdown %>
  <% if envelope_categories.any? %>
    <div class="space-y-3">
      <% envelope_categories.each do |cat| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-100 gap-2">
          <%= link_to cat[:name], category_path(cat[:id]), class: "text-gray-700 hover:text-brand-dark truncate" %>
          <span class="font-medium text-gray-900 shrink-0"><%= number_to_currency(cat[:amount]) %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-sm">No envelope spending <%= period_time_label %></p>
  <% end %>
</section>

<%# Untracked Categories %>
<% untracked = @presenter.untracked_expense_categories_breakdown %>
<% if untracked.any? %>
  <%= render "dashboard/untracked_breakdown", categories: untracked %>
<% end %>
<% end %>
