<% show_total = params[:show_total] == "true" %>
<% cache [current_user, selected_date, current_period, show_total, :expenses] do %>

<%# === UNRULED === %>
<section class="mb-12">
  <div class="border-l-4 border-terracotta pl-4 mb-6">
    <h2 class="text-xl font-semibold text-gray-900">Unruled spending</h2>
    <p class="text-sm text-gray-500">Spending no rule claims — it comes straight out of what's free.</p>
  </div>

  <%# Running-total chart %>
  <div class="mb-8">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <h3 class="text-lg font-medium text-gray-900"><%= @presenter.ytd? ? "YTD Unruled Spending" : "Unruled Spending" %></h3>
      <%= link_to reports_path(tab: @tab, period: params[:period], show_total: show_total ? "false" : "true"),
          class: "inline-flex items-center gap-2 px-3 py-1 text-xs font-medium rounded border #{show_total ? "border-brand bg-brand/10 text-brand-dark" : "border-gray-300 bg-white text-gray-500 hover:bg-gray-50"} transition" do %>
        <%= heroicon show_total ? "eye-slash" : "eye", options: { class: "h-3.5 w-3.5" } %>
        <%= show_total ? "Hide Total" : "Show Total" %>
      <% end %>
    </div>
    <div class="bg-gray-50 rounded p-4">
      <% if @presenter.expenses_chart_data.any? %>
        <%= line_chart @presenter.expenses_chart_data,
            curve: false,
            points: false,
            prefix: "$ ",
            colors: @presenter.expenses_chart_colors %>
      <% else %>
        <p class="text-gray-500 text-center py-8">No unruled spending <%= period_time_label %></p>
      <% end %>
    </div>
  </div>

  <%# Unruled stats %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
    <div class="bg-gray-50 rounded p-4">
      <p class="text-sm text-gray-500"><%= @presenter.ytd? ? "YTD Tracked Unruled Spending" : "Tracked Unruled Spending" %></p>
      <p class="text-2xl font-semibold text-brand-dark"><%= number_to_currency(@presenter.total_tracked_unruled_expenses) %></p>
    </div>
    <div class="bg-gray-50 rounded p-4">
      <p class="text-sm text-gray-500"><%= @presenter.ytd? ? "YTD Total Unruled Spending" : "Total Unruled Spending" %></p>
      <p class="text-2xl font-semibold text-terracotta"><%= number_to_currency(@presenter.total_unruled_expenses) %></p>
    </div>
  </div>

  <%# Unruled breakdown %>
  <% unruled_categories = @presenter.unruled_categories_breakdown %>
  <% if unruled_categories.any? %>
    <div class="space-y-3">
      <% unruled_categories.each do |cat| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-100 gap-2">
          <%= link_to cat[:name], category_path(cat[:id]), class: "text-gray-700 hover:text-brand-dark truncate" %>
          <span class="font-medium text-gray-900 shrink-0"><%= number_to_currency(cat[:amount]) %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-sm">No unruled spending <%= period_time_label %></p>
  <% end %>
</section>

<%# === RULED === %>
<section class="mb-12">
  <div class="border-l-4 border-dusty-teal pl-4 mb-6">
    <h2 class="text-xl font-semibold text-gray-900">Ruled spending</h2>
    <p class="text-sm text-gray-500">Spending a rule claims.</p>
  </div>

  <%# Ruled stats %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-gray-50 rounded p-4">
      <p class="text-sm text-gray-500"><%= @presenter.ytd? ? "YTD Tracked Ruled Spending" : "Tracked Ruled Spending" %></p>
      <p class="text-2xl font-semibold text-brand-dark"><%= number_to_currency(@presenter.total_tracked_ruled_expenses) %></p>
    </div>
    <div class="bg-gray-50 rounded p-4">
      <p class="text-sm text-gray-500"><%= @presenter.ytd? ? "YTD Total Ruled Spending" : "Total Ruled Spending" %></p>
      <p class="text-2xl font-semibold text-terracotta"><%= number_to_currency(@presenter.total_ruled_expenses) %></p>
    </div>
  </div>

  <%# Ruled breakdown %>
  <% ruled_categories = @presenter.ruled_categories_breakdown %>
  <% if ruled_categories.any? %>
    <div class="space-y-3">
      <% ruled_categories.each do |cat| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-100 gap-2">
          <%= link_to cat[:name], category_path(cat[:id]), class: "text-gray-700 hover:text-brand-dark truncate" %>
          <span class="font-medium text-gray-900 shrink-0"><%= number_to_currency(cat[:amount]) %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-sm">No ruled spending <%= period_time_label %></p>
  <% end %>
</section>

<%# Untracked Categories %>
<% untracked = @presenter.untracked_expense_categories_breakdown %>
<% if untracked.any? %>
  <%= render "dashboard/untracked_breakdown", categories: untracked %>
<% end %>
<% end %>
