<% content_for :title, "Budget" %>

<%= page_header(title: "Budget", subtitle: "The rules that fill your envelopes") %>

<div class="space-y-6">
  <% if @presenter.no_rules? %>
    <%= render "empty" %>
  <% else %>
    <%# The fill order itself: pool by pool, top to bottom, exactly as a distribution spends —
        banded by the account that spends it, because that is the scope one reorder rewrites. %>
    <% @presenter.account_bands.each do |band| %>
      <%= render "account_band", band: band %>
    <% end %>

    <%# Rules exist but none of them fills an envelope — every one is an orphan. Said plainly
        rather than left as a gap above the orphan band, which would read as a section that
        failed to render. %>
    <% if @presenter.pool_groups.empty? %>
      <section class="bg-white border border-gray-200 rounded px-6 py-4">
        <p class="text-sm text-gray-500">
          Nothing is in the fill order yet — none of your rules is attached to a pool an account can reach.
        </p>
      </section>
    <% end %>

    <%= render "orphans", presenter: @presenter %>
  <% end %>

  <%# OUTSIDE the no_rules? branch, deliberately. §8 puts the check under the rules, but a
      brand-new user with no rules is exactly the person who has declared nothing — sending the
      block away with the empty state would leave the only writer for `typical_income`,
      `period_cadence` and `period_anchor_date` in the app unreachable until they had made a rule.
      The check reads $0.00 for them, which is true. %>
  <%= render "structural_check", presenter: @presenter %>
</div>
