<%# One category, expanded: the rules table and one door onto another rule. Locals: `row`,
    `presenter`. The table is ClaimLine through Home's own three readers, so one rule reads once. %>
<div class="p-4 space-y-5" data-category-panel="<%= row.name %>">
  <% if row.ruled? %>
    <div data-rules-table>
      <%# The only labels, hidden below `sm` with the bar: at 375 the row is stripe · name · figure
          · when, which reads without headings. %>
      <div class="hidden sm:flex items-baseline gap-3 px-1 pb-1 text-xs uppercase tracking-wide text-gray-400">
        <span class="flex-1">Rule</span>
        <span class="w-40 text-right">Now</span>
        <span class="w-28">Progress</span>
        <span class="w-40">When</span>
        <span class="w-24 text-right">&nbsp;</span>
      </div>

      <ul class="divide-y divide-gray-100 border-t border-gray-100">
        <% row.lines.each do |line| %>
          <%# The hook is `rule_name` and the visible name is `ClaimLine#name`: every item-less rule
              answers to "Whole category", so a selector needs the item's name or the category's. %>
          <li class="py-3" data-rule="<%= rule_name(line.rule) %>">
            <%# The whole line is the summary: clicking anywhere on it opens the entries below, full
                width, and the frame loads once the details is visible, not before. %>
            <details data-rule-spending>
              <summary class="list-none cursor-pointer">
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
                  <div class="flex items-baseline gap-2 min-w-0 flex-1">
                    <%# The rule's type, never the category's: one category may carry a bill beside a
                        choice, and they give way at opposite ends of the walk. %>
                    <span class="w-1 self-stretch shrink-0 rounded <%= stripe_fill(line) %>" aria-hidden="true"></span>
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-gray-900 truncate"><%= line.name %></p>
                      <p class="text-xs <%= type_text_class(line) %>" data-rule-shape><%= shape_words(line) %></p>
                    </div>
                  </div>

                  <%# `over?` is the pre-clamp reader, and the only one that can tell "spent it exactly"
                      from "spent more than there was". %>
                  <p class="text-sm tabular-nums sm:w-40 sm:text-right <%= line.over? ? "text-status-danger font-medium" : "text-gray-700" %>"
                     data-rule-figure>
                    <%= figure_words(line) %> <span class="text-gray-400" aria-hidden="true">&#9662;</span>
                  </p>

                  <%# The percent rides on the TRACK: a 0% fill has no width, so a hook there would be
                      unassertable on exactly the row a bar most needs pinning. %>
                  <div class="hidden sm:block sm:w-28">
                    <% if line.bar? %>
                      <div class="h-1.5 bg-gray-200 rounded-full overflow-hidden"
                           role="progressbar"
                           aria-valuenow="<%= line.percent %>"
                           aria-valuemin="0"
                           aria-valuemax="100"
                           aria-label="<%= row.name %> · <%= line.name %>"
                           data-rule-bar="<%= line.percent %>"
                           data-rule-bar-state="<%= line.bar_state %>">
                        <div class="h-1.5 rounded-full <%= bar_fill(line) %>" style="width: <%= line.percent %>%;"></div>
                      </div>
                    <% end %>
                  </div>

                  <%# HomeHelper#when_words — the same string Home prints. A rate rule in a period with
                      no boundary declared has nothing to say and renders no element. %>
                  <p class="text-xs sm:w-40 <%= line.trouble? || line.short? ? "text-status-danger font-medium" : "text-gray-500" %>"
                     data-rule-when>
                    <%= when_words(line) %>
                  </p>

                  <%# A `div`, not a `p`: Delete is a `button_to`, and a form is not phrasing content. %>
                  <div class="flex items-baseline gap-3 shrink-0 sm:w-24 sm:justify-end text-sm">
                    <%# `_adjust` renders its own summary, so this column holds the rule's two doors.
                        All three wear RuleActionsHelper::RULE_ACTION_CLASSES — one string, not three. %>
                    <%= link_to "Edit",
                                edit_rule_path(line.rule),
                                class: rule_action_classes("mt-1 sm:mt-0 sm:text-right sm:underline") %>
                    <%# `text-status-danger` is declared after `text-brand-dark` in custom.css, so it
                        wins over the shared skin's colour without a second class list. %>
                    <%= button_to "Delete",
                                  rule_path(line.rule),
                                  method: :delete,
                                  form: { data: { turbo_confirm: "Delete this rule? Its adjustments go with it." } },
                                  class: rule_action_classes("mt-1 sm:mt-0 sm:text-right sm:underline text-status-danger") %>
                  </div>
                </div>
              </summary>

              <%= turbo_frame_tag dom_id(line.rule, :spending), src: spending_rule_path(line.rule), loading: :lazy, class: "block mt-2" do %>
                <p class="text-xs text-gray-500">Loading…</p>
              <% end %>
            </details>

            <%= render "budget_page/adjust", line: line %>

            <%# What was already done, in date order. The claim above counts every one of them; the
                list is what makes that figure explicable rather than merely asserted. %>
            <% if line.adjustments.any? %>
              <ul class="mt-2 space-y-1" data-rule-changes>
                <% line.adjustments.each do |change| %>
                  <li class="flex items-baseline gap-2 text-xs text-gray-600" data-change="<%= change.id %>">
                    <span class="text-gray-500"><%= change.date.strftime("%b %-d") %></span>
                    <%# Signed: the leading minus on a take-back is this table's whole vocabulary
                        said in one character. %>
                    <span class="<%= change.amount.negative? ? "text-status-danger" : "text-gray-900" %>" data-change-amount>
                      <%= number_to_currency(change.amount) %>
                    </span>
                    <%= button_to "Remove",
                                  adjustment_path(change, open: row.category.id),
                                  method: :delete,
                                  class: "text-brand-dark hover:text-brand underline" %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# The form is its own page, and this carries the category — so it opens knowing what the rule
      is for and the user never picks an owner out of a select. %>
  <div>
    <%= link_to "+ New rule for #{row.name}",
                new_rule_path(category_id: row.category.id),
                class: "btn btn-secondary w-full sm:w-auto",
                data: { new_rule_for: row.category.id } %>
  </div>
</div>
