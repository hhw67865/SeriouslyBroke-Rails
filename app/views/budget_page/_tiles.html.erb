<%# The three tiles. Local: `presenter`. Every figure is `standing_ask` — a constant of the rules
    and the grid — and never Σ claims, which would report a different split tomorrow. %>
<section class="grid grid-cols-2 gap-3 sm:grid-cols-3" data-tiles>
  <%# TILE 1 — what the rules ask of a period, and what kind of rules they are. %>
  <div class="col-span-2 bg-white border border-gray-200 rounded p-4 sm:col-span-1 sm:px-5 sm:py-4" data-tile="need">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Your rules need</h2>
    <p class="mt-1 text-xl font-semibold text-gray-900 tabular-nums" data-tile-figure>
      <%= number_to_currency(presenter.tiles.need) %> <span class="block text-sm font-normal text-gray-500 md:inline">a period</span>
    </p>

    <% if presenter.tiles.segments.any? %>
      <%# The percentages are the presenter's, so the bar and the figures under it are two readings
          of one number rather than two derivations of it. %>
      <div class="mt-3 flex h-2 overflow-hidden rounded bg-gray-100" data-type-bar>
        <% presenter.tiles.segments.each do |segment| %>
          <div class="<%= type_fill(segment.type) %>"
               style="width: <%= segment.percent %>%;"
               data-type-band="<%= segment.type %>"></div>
        <% end %>
      </div>

      <%# The separator is `aria-hidden`, so a reader hears three figures and not three interpuncts.
          A type with no rules is absent: $0.00 is true and reports nothing. %>
      <p class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs text-gray-700">
        <% presenter.tiles.segments.each_with_index do |segment, index| %>
          <% unless index.zero? %>
            <span class="text-gray-400" aria-hidden="true">·</span>
          <% end %>
          <span data-type-total="<%= segment.type %>">
            <span class="text-gray-500"><%= rule_type_heading(segment.type) %></span>
            <span class="font-medium text-gray-900 tabular-nums"><%= number_to_currency(segment.amount) %></span>
          </span>
        <% end %>
      </p>
    <% end %>
  </div>

  <%# TILE 2 — what the entries say comes in, measured rather than typed. %>
  <div class="bg-white border border-gray-200 rounded p-4 sm:px-5 sm:py-4" data-tile="income">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">You bring in</h2>
    <% if presenter.tiles.declared? %>
      <% if presenter.history? %>
        <p class="mt-1 text-xl font-semibold text-gray-900 tabular-nums" data-tile-figure>
          <%= number_to_currency(presenter.tiles.income) %> <span class="block text-sm font-normal text-gray-500 md:inline">a period</span>
        </p>
      <% else %>
        <%# Measured, not asked for: until a period has completed there is nothing to average, and
            a zero here would be a claim about the user's income rather than the absence of one. %>
        <p class="mt-1 text-sm text-gray-500" data-tile-figure>not enough history yet</p>
      <% end %>
      <p class="mt-2 text-xs text-gray-500">
        <span data-tile-cadence><%= presenter.tiles.cadence.humanize %></span> ·
        <%= link_to "change",
                    budget_page_path(declare: 1),
                    class: "inline-flex min-h-10 items-center text-brand-dark hover:text-brand underline sm:min-h-0",
                    data: { declare_link: true } %>
      </p>
    <% else %>
      <p class="mt-1 text-sm text-gray-500" data-tile-figure>Not said yet</p>
      <p class="mt-2 text-xs">
        <%= link_to "Set your period",
                    budget_page_path(declare: 1),
                    class: "inline-flex min-h-10 items-center text-brand-dark hover:text-brand underline sm:min-h-0",
                    data: { declare_link: true } %>
      </p>
    <% end %>
  </div>

  <%# TILE 3 — the subtraction, green when it fits and red when it does not. %>
  <div class="bg-white border rounded p-4 sm:px-5 sm:py-4 <%= presenter.declared? && presenter.history? && !presenter.tiles.fits? ? "border-status-danger" : "border-gray-200" %>"
       data-tile="leftover">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Left over</h2>
    <% if presenter.tiles.declared? && presenter.history? %>
      <p class="mt-1 text-xl font-semibold tabular-nums <%= presenter.tiles.fits? ? "text-status-success" : "text-status-danger" %>"
         data-tile-figure>
        <%= number_to_currency(presenter.tiles.leftover) %>
      </p>
      <p class="mt-2 text-xs text-gray-500" data-tile-verdict>
        <%= presenter.tiles.fits? ? "Your rules fit what you bring in." : "Your rules ask for more than you bring in." %>
      </p>

      <%# Reallocation cannot fix a budget that does not fit an income, and `sacrifice_path` refuses
          in exactly the two states this button is not shown in. %>
      <% unless presenter.tiles.fits? %>
        <%= link_to("What could you cut?",
                    sacrifice_path,
                    class: "mt-3 inline-flex items-center gap-2 px-3 py-2.5 rounded border sm:py-1.5 " \
                           "border-status-danger bg-status-danger-light text-status-danger " \
                           "text-xs font-medium hover:bg-white",
                    data: { sacrifice_link: true }) %>
      <% end %>
    <% else %>
      <p class="mt-1 text-sm text-gray-500" data-tile-figure>
        Once your period is set and a full one has passed, this will say whether your rules fit.
      </p>
    <% end %>
  </div>
</section>
