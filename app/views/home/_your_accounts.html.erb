<%# "YOUR ACCOUNTS" — the door to a new account. Locals: `account` (unsaved, or the rejected one
    carrying its errors at 422) and `balance` (what was typed into the row when that 422 happened). %>
<section class="bg-white border border-gray-200 rounded" aria-labelledby="your-accounts-heading">
  <div class="px-6 py-3 border-b border-gray-200">
    <h3 id="your-accounts-heading" class="text-sm font-semibold text-gray-900">Your accounts</h3>
  </div>

  <%= simple_form_for account, as: :account, url: accounts_path do |f| %>
    <div class="px-6 py-4 flex flex-col sm:flex-row sm:items-start gap-3">
      <div class="flex-1">
        <%= f.input :name,
            label: "Account name",
            placeholder: "e.g., Ally Savings",
            hint: "Add every account your income reaches." %>
      </div>
      <div class="flex-1">
        <%# No `min` on this one: the FIRST account a user adds becomes their main account, and an
            overdrawn checking account is a fact. %>
        <%= f.input :balance,
            as: :decimal,
            label: "What's in it right now",
            placeholder: "0.00",
            required: false,
            input_html: { step: 0.01, value: balance },
            hint: "Optional — you can say later." %>
      </div>
      <div class="sm:pt-7">
        <%= f.button :submit, "Add an account", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>
