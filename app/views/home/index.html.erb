<% content_for :title, "Home" %>

<%= page_header(title: "Home", subtitle: "Where your money stands") %>

<%# ANSWERS FIRST (answers-first spec §1). The hero card leads because the two questions a user
    actually opens this screen with — how much is in my checking, how much of it is free — are its
    two figures; everything below it is the working. The remaining bands are still the two-ledger
    ones (spec §2) and Task 2 replaces them: the attention band becomes the trouble strip, the
    categories band becomes spent-of-planned bars, and the accounts collapse to one line. %>
<div class="space-y-6">
  <%= render "hero", presenter: @presenter %>
  <%= render "attention", presenter: @presenter %>
  <%= render "categories", presenter: @presenter %>
  <% @presenter.accounts.each do |account| %>
    <%= render "account", presenter: @presenter, account: account %>
  <% end %>
  <%= render "new_account", bank_account: @new_bank_account %>
</div>
