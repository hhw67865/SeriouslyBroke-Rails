<%# THE ACCOUNTS, DEMOTED TO ONE LINE. Local: `presenter` (HomePresenter). Main is out of the
    figure, because main's balance IS the money row's "In checking". %>
<% accounts = presenter.accounts %>
<% others = presenter.other_accounts %>
<% if accounts.any? %>
  <%# `<details>`/`<summary>` rather than a Stimulus controller — the whole interaction is "show me
      the rest", it needs no JavaScript, and it survives a Turbo navigation. %>
  <details class="bg-white border border-gray-200 rounded" data-accounts>
    <summary class="px-6 py-3 text-sm text-gray-700 cursor-pointer hover:text-gray-900" data-accounts-line>
      <% if others.any? %>
        <strong class="tabular-nums"><%= number_to_currency(presenter.other_accounts_total) %></strong>
        across <%= pluralize(others.size, "other account") %>
      <% else %>
        <%# No figure, because "$0.00 across 0 other accounts" would be an invented absence. Not
            "Your accounts" either — that is the heading of the card below. %>
        Account details
      <% end %>
    </summary>

    <%# A tray rather than a continuation of the card: `_account` renders its own bordered section. %>
    <div class="border-t border-gray-200 bg-gray-50 p-3 space-y-3">
      <% accounts.each do |account| %>
        <%= render "home/account", presenter: presenter, account: account %>
      <% end %>
    </div>
  </details>
<% end %>
