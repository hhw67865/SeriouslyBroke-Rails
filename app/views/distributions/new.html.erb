<% content_for :title, "Distribute" %>

<%# The page header names the PERIOD; the headline below it names the amount. It used to name the
    ACCOUNT, which was the thing a user with more than one of them needed to see — and there is no
    account here any more (two-ledger spec §2: one root, one distribution per period). The period is
    what identifies this screen now, and it is still not the word "Distribute" in the largest type
    on the screen directly above `Distribute $600.00`. %>
<%= page_header(title: "Distribution",
                subtitle: "#{@presenter.period.first.strftime("%b %-d")} – " \
                          "#{@presenter.period.last.strftime("%b %-d")}") %>

<div class="space-y-6">
  <%# A refused confirm, at the top: everything below it has gone back to being a proposal, and
      that is not visible from the figures alone. Only #create sets this, so a screen that has
      never been confirmed carries nothing. %>
  <% if @errors.present? %>
    <%= render "errors", errors: @errors %>
  <% end %>

  <%# Only when this period has been distributed before. A banner that fired on every visit
      would say nothing, and this one has to be believed the one time it matters. %>
  <% if @presenter.redistribution? %>
    <%= render "replacement", presenter: @presenter %>
  <% end %>

  <%= render "sources", presenter: @presenter %>

  <%# THE DENSITY SWITCH, chosen by the data and never by a setting (spec §5). Nothing short and
      nothing red → the card above has said so in one line and there is nothing here to decide.
      Anything short OR overdue → the full waterfall, uncollapsed, because a single confirm over
      a collapsed screen either starves the bottom rows or calls a late bill fine. %>
  <% if @presenter.expanded? %>
    <%= render "waterfall", presenter: @presenter %>
  <% else %>
    <%# The all-clear density's ONE button (spec §5). The waterfall carries its own, beside the
        recompute, so this branch is the whole of the collapsed screen's action — without it a
        comfortable period is a screen with nothing to press. %>
    <div class="flex items-center justify-between gap-4">
      <p class="text-xs text-gray-500">Nothing has moved yet.</p>
      <%= render "confirm", presenter: @presenter, standalone: true %>
    </div>
  <% end %>
</div>
