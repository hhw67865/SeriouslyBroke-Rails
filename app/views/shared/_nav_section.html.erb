<%# Navigation Section %>
<div class="px-3 mt-6">
  <div class="text-sm font-semibold text-on-dark-light uppercase tracking-wider px-3 mb-2">
    <%= title %>
  </div>
  <nav class="space-y-1">
    <% links.each do |link| %>
      <% 
        # Check if current path starts with the nav link path (handles sub-pages automatically)
        # Special case: root path should only match exactly, not all paths starting with "/"
        is_active = if link[:path] == "/"
                      request.path == "/"
                    else
                      request.path.start_with?(link[:path]) && link[:path] != "#"
                    end
      %>
      <%# `data:` is optional and per link, and NO LINK CARRIES ONE TODAY (computed-claims spec §6).
          The one that did was Distribute: it passed `turbo_prefetch: false` because turbo-rails
          prefetches on hover and that GET took write locks, so hovering the nav item fired a
          snapshot that deleted a period's split and rolled it back. There is no such screen and no
          such write; every reader in this app is now a pure function of rows nobody's mouse can
          touch. The keyword is kept because the next link that needs one should not have to
          re-derive that a nav link may carry data attributes. %>
      <%= link_to link[:path],
          data: link[:data],
          class: class_names(
            "flex items-center px-3 py-2.5 text-base font-medium rounded transition-colors",
            "border-l-2",
            is_active ? 
              "bg-white text-brand-dark border-brand-dark" : 
              "text-on-dark hover:bg-white/5 border-transparent"
          ) do %>
        <span class="mr-3">
          <%= heroicon link[:icon], options: { class: "w-5 h-5" } %>
        </span>
        <%= link[:name] %>
      <% end %>
    <% end %>
  </nav>
</div> 