<%# Main Sidebar Container %>
<div data-controller="shared--sidebar">
  <%# Mobile Toggle Button %>
  <div class="fixed inset-0 bg-gray-900/80 backdrop-blur-sm lg:hidden" 
       aria-hidden="true"
       data-shared--sidebar-target="overlay"
       data-action="click->shared--sidebar#close"></div>

  <%# Mobile Header %>
  <div class="sticky top-0 z-40 flex h-16 items-center gap-x-4 bg-white/95 backdrop-blur-sm px-4 shadow-[0_1px_3px_rgba(0,0,0,0.02)] sm:gap-x-6 sm:px-6 lg:hidden">
    <button type="button" 
            class="-m-2.5 p-2.5 text-gray-700 hover:text-brand transition-all duration-200 ease-in-out rounded active:scale-95 lg:hidden"
            data-action="shared--sidebar#toggle">
      <span class="sr-only">Open sidebar</span>
      <%= heroicon "bars-3", options: { class: "h-6 w-6" } %>
    </button>

    <div class="flex-1 text-xl font-bold tracking-tight">
      <span class="text-brand-dark">Seriously</span><span class="text-brand">Broke</span>
    </div>
    
    <%# Date Selector for Mobile %>
    <%= render "shared/date_selector", variant: "mobile" %>
  </div>

  <%# Sidebar for Desktop and Mobile %>
  <div data-shared--sidebar-target="panel"
       class="fixed inset-y-0 left-0 z-50 w-full -translate-x-full bg-gradient-to-br from-brand to-brand-dark transition-transform duration-300 ease-in-out lg:w-64 lg:translate-x-0">
    
    <%# Sidebar Content %>
    <div class="flex h-full flex-col">
      <%# Close button for mobile %>
      <div class="absolute right-0 top-0 flex pr-2 pt-2 lg:hidden">
        <button type="button" 
                class="ml-1 flex h-10 w-10 items-center justify-center rounded bg-white/10 text-white hover:bg-white/20 transition-all duration-200 ease-in-out active:scale-95 focus:outline-none"
                data-action="shared--sidebar#close">
          <span class="sr-only">Close sidebar</span>
          <%= heroicon "x-mark", options: { class: "h-6 w-6" } %>
        </button>
      </div>

      <%= render "shared/brand" %>
      
      <%# Date Selector %>
      <%= render "shared/date_selector", variant: "sidebar" %>
      
      <div class="flex-1 overflow-y-auto">
        <nav class="flex flex-1 flex-col">
          <ul role="list" class="flex flex-1 flex-col gap-y-7">
            <%# Main Navigation %>
            <%= render "shared/nav_section", 
                title: "Main",
                links: [
                  { name: "Home", path: root_path, icon: "home" },
                  # THE ONLY WAY INTO THE DISTRIBUTION SCREEN, and it is here because it is an
                  # ACTION on the household's money rather than a report on it — beside Home and
                  # Entries, not under Analysis. Until this link existed the headline feature of
                  # the plan shipped dark: nothing in `app/` outside the distributions controller
                  # and its own views named the route, so the only way to split a paycheck was to
                  # type the URL. Home's waterfall band links here too; that band is conditional
                  # and this is not.
                  {
                    name: "Distribute",
                    path: new_distribution_path,
                    icon: "arrows-right-left",
                    data: { turbo_prefetch: false }
                  },
                  # THE RULES THEMSELVES, between the action that spends them and the ledger that
                  # records what was spent — a rule is neither a report nor a category, and until
                  # this link existed §8's page had no way in but the URL. `/budget` is a prefix
                  # of `/budgets/:id/edit`, so a rule's own form highlights this item too, which
                  # is right: rule editing is what this page owns.
                  { name: "Budget", path: budget_page_path, icon: "adjustments-horizontal" },
                  { name: "Entries", path: entries_path, icon: "document-text" }
                ]
            %>
            
            <%# Management Section %>
            <%= render "shared/nav_section",
                title: "Management",
                links: [
                  # THE "Pools" ITEM IS GONE (two-ledger spec §5, Task 7). It opened the savings
                  # goals index, and a savings goal is a CATEGORY now — target, priority, funding
                  # start and all — so Categories is the one screen for what money is for, and
                  # this section has one link.
                  { name: "Categories", path: categories_path, icon: "tag" }
                ]
            %>
            
            <%# Analysis Section %>
            <%# CALENDAR BEFORE REPORTS — spec §2's order, and the last step of the demotion.
                §2 ends `… Calendar · Reports`, with Reports last because that is what "relocated,
                not weakened" means: the charts answer *what happened*, a question you visit
                deliberately, so nothing in the sidebar may sit below them and read as more
                incidental than they are. Reports was first in this section while it was still
                called the Dashboard and still the app's front door; it is neither now. %>
            <%= render "shared/nav_section",
                title: "Analysis",
                links: [
                  { name: "Calendar", path: calendar_path, icon: "calendar" },
                  { name: "Reports", path: reports_path, icon: "chart-bar" }
                ]
            %>
          </ul>
        </nav>
      </div>
      
      <%= render "shared/user_profile" %>
    </div>
  </div>
</div> 