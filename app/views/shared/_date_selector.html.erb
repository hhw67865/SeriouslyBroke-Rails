<%
  # Default values (from helpers backed by session)
  current_month = selected_month
  current_year = selected_year

  # Compute prev/next month-year pairs
  if current_month == 1
    prev_month = 12
    prev_year = current_year - 1
  else
    prev_month = current_month - 1
    prev_year = current_year
  end

  if current_month == 12
    next_month = 1
    next_year = current_year + 1
  else
    next_month = current_month + 1
    next_year = current_year
  end

  # Preserve existing query params for form redirects — SCALARS ONLY.
  #
  # These ride along as `hidden_field key, value: value`, which writes ONE box holding the value's
  # #to_s. A nested param therefore does not survive: the distribution screen's
  # `overrides[<pool id>]` hash came out the other side as a single scalar
  # `overrides=<inspected hash>`, which only DistributionsController#override_params' type guard
  # kept from being a 500.
  #
  # Dropping them is also the right BEHAVIOUR, not just the safe one: a month arrow moves to a
  # different period, whose proposal has different rows, so an edit carried across it would name
  # rows that no longer exist. Dropped deliberately here rather than mangled into something a
  # guard downstream has to catch.
  #
  # EVERY HIDDEN FIELD BELOW IS RENDERED `id: nil`, AND THAT IS A CORRECTNESS FIX RATHER THAN
  # TIDINESS. `f.hidden_field :amount` writes `id="amount"` as well as the name, and this partial
  # renders FOUR such forms on every page — two here, twice over, because _sidebar renders both the
  # `sidebar` and the `mobile` variant. So `month` and `year` already appeared four times as ids on
  # every page in the app, and each preserved query parameter appeared four more.
  #
  # That is invalid HTML on its own, and it is a live trap for any screen naming a form field after
  # its own query parameter: `label for=` and `document.getElementById` both resolve to the FIRST
  # match in the document, which is one of these hidden inputs, not the box the user types in.
  # Measured on Task 7's reallocation screen — `getElementById("amount")` returned
  # `<input type="hidden" name="amount" value="300">` rather than its number field, and every
  # system example passed either way because Capybara filters invisible elements and happened to
  # land on the right one.
  #
  # Fixed HERE and generically rather than by renaming the fields on each screen that trips on it,
  # for the same reason the nested-param guard below was made generic rather than
  # distribution-specific: the next screen to hit this will not suspect a shared partial. These
  # inputs are pure form payload — nothing in the app targets them by id (no CSS, no JavaScript, no
  # label, no spec), and a form field needs a name to be submitted, never an id.
  base_params = request.query_parameters.deep_dup.symbolize_keys
                       .except(:month, :year)
                       .select { |_key, value| value.is_a?(String) }
  
  # Style variant: 'sidebar' for desktop sidebar, 'mobile' for mobile header
  variant = local_assigns[:variant] || "sidebar"
  
  # Base classes for different variants
  container_classes = variant == "sidebar" ? "p-4 border-b border-light" : "flex items-center gap-1"
  
  # Professional arrow buttons (rectangular, high-contrast)
  button_classes = if variant == "sidebar"
    "inline-flex items-center justify-center px-2.5 py-2 rounded bg-white text-brand border border-brand hover:bg-brand-dark hover:text-white shadow-sm transition"
                   else
    "inline-flex items-center justify-center px-2.5 py-2 rounded bg-white text-gray-800 border border-gray-300 hover:bg-gray-100 shadow-sm transition"
  end
  
  # Date display (neutral text-only inside group)
  date_display_classes = if variant == "sidebar"
    "px-4 py-2 text-sm font-semibold text-brand-dark text-center"
                         else
    "px-3 py-2 text-sm font-semibold text-gray-900 text-center"
  end

  # Grouped control styling (single widget look)
  group_classes = if variant == "sidebar"
    "flex w-full items-stretch rounded border-2 border-brand bg-white shadow-sm"
                  else
    "inline-flex items-stretch rounded border border-gray-300 bg-white shadow-sm"
  end

  # Base button within group
  btn_group_base = if variant == "sidebar"
    "w-10 h-full flex items-center justify-center px-0 py-2 text-brand-dark hover:bg-brand/10 transition focus:outline-none"
                   else
    "w-10 h-full flex items-center justify-center px-0 py-2 text-gray-800 hover:bg-gray-100 transition focus:outline-none"
  end

  # Divider color between segments
  divider_class = variant == "sidebar" ? "border-brand" : "border-gray-300"
%>

<div class="<%= container_classes %>">
  
  <div class="<%= group_classes %> <%= "justify-center" if variant == "sidebar" %>">
    <!-- Previous Month (left segment) -->
    <%= form_with url: request.path, method: :get, local: true, class: "m-0 inline" do |f| %>
      <% base_params.each do |key, value| %>
        <%= f.hidden_field key, value: value, id: nil %>
      <% end %>
      <%= f.hidden_field :month, value: prev_month, id: nil %>
      <%= f.hidden_field :year, value: prev_year, id: nil %>
      <button type="submit" class="<%= btn_group_base %> rounded-l border-r <%= divider_class %> border-0 cursor-pointer" title="Previous month">
        <%= heroicon "chevron-left", options: { class: "w-5 h-5" } %>
      </button>
    <% end %>

    <!-- Month/Year (center segment) -->
    <div class="<%= date_display_classes %> select-none cursor-default flex-1 text-center">
      <%= Date.new(current_year, current_month).strftime(variant == "mobile" ? "%b %Y" : "%B %Y") %>
    </div>

    <!-- Next Month (right segment) -->
    <%= form_with url: request.path, method: :get, local: true, class: "m-0 inline" do |f| %>
      <% base_params.each do |key, value| %>
        <%= f.hidden_field key, value: value, id: nil %>
      <% end %>
      <%= f.hidden_field :month, value: next_month, id: nil %>
      <%= f.hidden_field :year, value: next_year, id: nil %>
      <button type="submit" class="<%= btn_group_base %> rounded-r border-l <%= divider_class %> border-0 cursor-pointer" title="Next month">
        <%= heroicon "chevron-right", options: { class: "w-5 h-5" } %>
      </button>
    <% end %>
  </div>
</div>
