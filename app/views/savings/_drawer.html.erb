<%# DRAWER — a native <dialog>: a slide-in panel from `sm` up, a bottom sheet below it. Locals:
    `name` ("transfer"/"add", the JS/CSS hook), `title`, `open` (rendered non-modal; the drawer
    controller promotes it to modal on connect). %>
<dialog data-drawer-name="<%= name %>"
        data-shared--drawer-target="dialog"
        data-action="click->shared--drawer#close"
        <%= "open" if open %>>
  <div class="mx-auto mt-2 h-1 w-9 shrink-0 rounded-full bg-gray-300 sm:hidden"></div>

  <div class="flex shrink-0 items-center justify-between border-b border-gray-200 px-4 py-3 sm:px-6">
    <h2 class="text-sm font-semibold text-gray-900"><%= title %></h2>
    <button type="button" aria-label="Close" class="text-gray-400 hover:text-gray-600"
            data-action="click->shared--drawer#close">&times;</button>
  </div>

  <div class="flex-1 overflow-y-auto px-4 py-4 sm:px-6">
    <%= yield %>
  </div>
</dialog>
