<%# ADD AN ACCOUNT — every new one is set aside, not spending: `Account.open` only makes an account
    main when the user has none yet. Locals: `account` (unsaved, or refused and carrying its
    errors), `balance` (what was typed when a refusal happened), `open`. %>
<details class="mt-2" data-add-account <%= "open" if open %>>
  <summary class="btn btn-secondary list-none inline-flex cursor-pointer">Add an account</summary>

  <div class="mt-3 max-w-2xl rounded border border-gray-200 bg-gray-50 p-4">
    <p class="mb-3 text-xs text-gray-600">New accounts are set aside, not spending.</p>

    <%= simple_form_for account, as: :account, url: accounts_path do |f| %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
        <div class="flex-1">
          <%= f.input :name, label: "Account name", placeholder: "e.g., Ally Savings" %>
        </div>
        <div class="flex-1">
          <%= f.input :balance,
              as: :decimal,
              label: "What's in it right now",
              placeholder: "0.00",
              required: false,
              input_html: { step: 0.01, value: balance } %>
        </div>
        <div class="sm:pt-7">
          <%= f.button :submit, "Add an account", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</details>
