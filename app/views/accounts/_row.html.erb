<%# ONE SET-ASIDE ACCOUNT. Local: `row` (AccountsPresenter::Row). Folds to name+balance on one line
    with the two facts beneath it below `sm`, where a five-column row has nowhere else to put them. %>
<tr class="block sm:table-row py-3 sm:py-2" data-account-row="<%= row.account.name %>">
  <td class="block sm:table-cell sm:py-2 sm:pr-3">
    <div class="flex items-baseline justify-between gap-3 sm:block">
      <span class="font-medium text-gray-900"><%= row.account.name %></span>
      <span class="tabular-nums sm:hidden <%= row.balance.negative? ? "text-status-danger" : "text-gray-900" %>">
        <%= number_to_currency(row.balance) %>
      </span>
    </div>
    <% if row.opened_words %>
      <div class="text-xs text-gray-500"><%= row.opened_words %></div>
    <% end %>
  </td>
  <td class="hidden sm:table-cell sm:py-2 sm:px-3 text-right tabular-nums <%= row.balance.negative? ? "text-status-danger" : "text-gray-900" %>">
    <%= number_to_currency(row.balance) %>
  </td>
  <td class="block sm:table-cell sm:py-2 sm:px-3 text-sm text-gray-700" data-account-moved="<%= row.account.name %>">
    <span class="sm:hidden text-xs text-gray-500">Last moved </span><%= row.moved_words %>
  </td>
  <td class="block sm:table-cell sm:py-2 sm:pl-3">
    <div class="mt-2 flex flex-wrap items-center gap-4 sm:mt-0">
      <%= link_to "Edit",
                  edit_account_path(row.account),
                  class: "text-xs font-medium text-brand hover:text-brand-dark",
                  data: { account_edit: row.account.name } %>
      <%# What the confirm promises is what deleting actually does: transfers deleted, their money
          back on main, the opening balance with it. %>
      <% confirm = "Delete #{row.account.name}? The transfers into and out of it are deleted with it, " \
                   "so the money they moved goes back to your main account — and whatever it was " \
                   "opened with goes with it. Your balances will change. This action cannot be " \
                   "undone." %>
      <%= button_to "Delete",
                    account_path(row.account),
                    method: :delete,
                    class: "text-xs font-medium text-gray-500 hover:text-status-danger " \
                           "focus-visible:text-status-danger transition-colors",
                    form: { class: "inline-block leading-none", data: { turbo_confirm: confirm } },
                    data: { account_delete: row.account.name } %>
    </div>
  </td>
</tr>
