<%# ADD AN ACCOUNT — every new one is set aside, not spending: `Account.open` only makes an account
    main when the user has none yet. Locals: `account` (unsaved, or refused and carrying its
    errors), `balance` (what was typed when a refusal happened). %>
<p class="text-xs text-gray-600">New accounts are set aside, not spending.</p>

<%= simple_form_for account, as: :account, url: accounts_path, html: { class: "mt-3 space-y-3" } do |f| %>
  <%= f.input :name, label: "Account name", placeholder: "e.g., Ally Savings" %>
  <%= f.input :balance,
      as: :decimal,
      label: "What's in it right now",
      placeholder: "0.00",
      required: false,
      input_html: { step: 0.01, value: balance } %>

  <div class="mt-6 flex gap-2 sm:justify-end">
    <button type="button" class="btn btn-secondary flex-1 sm:flex-none"
            data-action="click->shared--drawer#close">Cancel</button>
    <%= f.button :submit, "Add account", class: "btn btn-primary flex-1 sm:flex-none" %>
  </div>
<% end %>
