<%# MOVE MONEY — a hand move between two of the user's own accounts, never spending or income.
    Locals: `presenter` (AccountsPresenter), `transfer` (new, or refused and carrying its errors),
    `move_to` (a preselected destination id). %>
<p class="text-sm text-gray-600">
  Between your own accounts. A move is not spending and not income; it changes two balances and
  nothing else.
</p>

<%= form_with model: transfer, url: transfers_path, class: "mt-3 space-y-3" do |f| %>
  <% if transfer.errors.any? %>
    <p class="form-error"><%= transfer.errors.full_messages.to_sentence %></p>
  <% end %>

  <div class="form-group">
    <%= f.label :from_account_id, "From", class: "form-label" %>
    <%= f.select :from_account_id,
        options_from_collection_for_select(presenter.accounts, :id, :name, transfer.from_account_id || presenter.spending.id),
        {},
        class: "form-select" %>
  </div>

  <div class="form-group">
    <%= f.label :to_account_id, "To", class: "form-label" %>
    <%= f.select :to_account_id,
        options_from_collection_for_select(presenter.accounts, :id, :name, transfer.to_account_id || move_to || presenter.set_aside.first&.account&.id),
        {},
        class: "form-select" %>
  </div>

  <div class="form-group">
    <%= f.label :amount, class: "form-label" %>
    <%= f.number_field :amount, step: 0.01, min: 0.01, value: transfer.amount, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :date, "Date", class: "form-label" %>
    <%= f.date_field :date, value: transfer.date || presenter.today, class: "form-input" %>
  </div>

  <div class="mt-6 flex gap-2 sm:justify-end">
    <button type="button" class="btn btn-secondary flex-1 sm:flex-none"
            data-action="click->shared--drawer#close">Cancel</button>
    <%= f.submit "Move", class: "btn btn-primary flex-1 sm:flex-none" %>
  </div>
<% end %>
