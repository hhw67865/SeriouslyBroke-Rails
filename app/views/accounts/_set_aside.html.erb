<%# SET ASIDE ELSEWHERE — every account but the spending one, as a ledger. Move money and Add an
    account open from the buttons here. Local: `presenter` (AccountsPresenter). %>
<div class="bg-white border border-gray-200 rounded p-4 lg:p-6" data-set-aside>
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
    <div>
      <h2 class="text-sm font-semibold text-gray-900">Set aside elsewhere</h2>
      <p class="mt-1 text-sm text-gray-600">
        Savings and holding accounts. Money here is yours, but no rule claims it and nothing you
        budget comes out of it.
      </p>
    </div>
    <div class="flex flex-col items-stretch sm:items-end gap-2">
      <% if presenter.set_aside.any? %>
        <p class="text-sm text-gray-700 tabular-nums shrink-0" data-set-aside-total>
          <strong><%= number_to_currency(presenter.set_aside_total) %></strong>
          across <%= pluralize(presenter.set_aside.size, "account") %>
        </p>
      <% end %>
      <div class="grid grid-cols-2 gap-2 sm:flex sm:justify-end">
        <%= link_to "Move money",
            accounts_path(open: "move"),
            class: "btn btn-secondary",
            data: { drawer: "move", action: "click->shared--drawer#open" } %>
        <%= link_to "Add an account",
            accounts_path(open: "add"),
            class: "btn btn-primary",
            data: { drawer: "add", action: "click->shared--drawer#open" } %>
      </div>
    </div>
  </div>

  <% if presenter.set_aside.empty? %>
    <p class="mt-4 text-sm text-gray-600" data-set-aside-empty>
      Nothing set aside yet. Add an account to start.
    </p>
  <% else %>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="hidden sm:table-header-group">
          <tr class="border-b border-gray-200 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
            <th class="py-2 pr-3">Account</th>
            <th class="py-2 px-3 text-right">Balance</th>
            <th class="py-2 px-3">Income last landed</th>
            <th class="py-2 px-3">Last moved</th>
            <th class="py-2 pl-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="block sm:table-row-group divide-y divide-gray-100">
          <% presenter.set_aside.each do |row| %>
            <%= render "accounts/row", row: row %>
          <% end %>
        </tbody>
        <tfoot class="block sm:table-footer-group">
          <tr class="block sm:table-row border-t border-gray-200 font-semibold text-gray-900">
            <td class="block sm:table-cell sm:py-2 sm:pr-3">Total</td>
            <td class="block sm:table-cell sm:py-2 sm:px-3 sm:text-right tabular-nums" data-set-aside-footer>
              <%= number_to_currency(presenter.set_aside_total) %>
            </td>
            <td class="hidden sm:table-cell sm:py-2 sm:px-3" colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
