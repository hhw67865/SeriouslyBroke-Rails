<% content_for :title, @category.name %>

<%= page_header(
    title: @category.name,
    subtitle: "#{@category.category_type.titleize} category details and management",
    breadcrumbs: [
      { label: "Categories", url: categories_path(type: @category.category_type) },
      { label: @category.name }
    ],
    actions: [
      {
        label: "Manage Items",
        url: category_items_path(@category),
        class: "inline-flex items-center gap-2 px-4 py-2 rounded border border-gray-300 bg-white text-gray-700 text-sm font-medium hover:bg-gray-50 shadow-sm transition"
      },
      {
        label: "Edit",
        url: edit_category_path(@category),
        class: "inline-flex items-center gap-2 px-4 py-2 rounded border border-gray-300 bg-white text-gray-700 text-sm font-medium hover:bg-gray-50 shadow-sm transition"
      },
      {
        label: "Delete",
        url: category_path(@category),
        method: :delete,
        class: "inline-flex items-center gap-2 px-4 py-2 rounded bg-status-danger text-white text-sm font-medium hover:opacity-90 shadow-sm transition",
        confirm: "Are you sure you want to delete #{@category.name}? This will permanently delete all #{@category.items.size} item(s) and #{@category.entries.size} entry/entries. This action cannot be undone."
      }
    ]
) %>

<div class="container mx-auto px-4 py-6">
  <%= render "categories/_partials/show/category_banner", category: @category %>

  <%= render "shared/period_toggle",
      monthly_path: category_path(@category),
      ytd_path: category_path(@category, period: "ytd") %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left Column -->
    <div class="lg:col-span-2 space-y-6">
      <%# The cache covers the left column only. What a category CLAIMS moves with the calendar and
          with rules on another screen, so the holdings card is outside it. %>
      <% cache [@category, selected_date, current_period] do %>
        <%= render "categories/_partials/show/summary_card", category: @category %>
        <%= render "categories/_partials/show/items_list", category: @category %>
      <% end %>
    </div>

    <!-- Right Column -->
    <div class="space-y-6">
      <%= render "categories/_partials/show/details_card", category: @category %>

      <%# Every expense category gets the card, in the two states one can be in. An income category
          claims nothing and gets none. %>
      <% if @holdings_card %>
        <%= render "categories/_partials/show/holdings_card", presenter: @holdings_card %>
      <% end %>

      <%= render "categories/_partials/show/recent_activity", category: @category %>
    </div>
  </div>
</div>
