<%= simple_form_for(category) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div data-controller="app--category--form">
    <div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 mb-6">
      <div class="p-6">
        <h2 class="text-xl font-semibold mb-4">Basic Information</h2>
        
        <%= f.input :name, placeholder: "e.g. Groceries, Salary, Vacation Fund" %>

        <div class="space-y-2 mt-5">
          <%# TWO TYPES, TWO TILES (plan 3, task 5). `Category.category_types` drives the loop, so
              the savings tile disappeared with the enum value; the grid closes at two rather than
              leaving a third of the row empty. %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% Category.category_types.keys.each do |type| %>
              <div>
                <label class="cursor-pointer flex flex-col">
                  <div class="relative">
                    <%= f.radio_button :category_type, 
type, 
                                      class: "sr-only", 
                                      data: { 
                                        action: "change->app--category--form#selectCategoryType"
                                      } %>
                    <div class="w-full border-2 rounded p-4 transition-all flex flex-col items-center category-type-option
                              <%= f.object.category_type == type ? "border-brand bg-brand-light" : "border-gray-200 hover:border-gray-300" %>"
                        data-type="<%= type %>"
                        data-app--category--form-target="categoryTypeOption">
                      <div class="w-10 h-10 rounded-md flex items-center justify-center mb-2 
                                <%= f.object.category_type == type ? "bg-brand" : "bg-gray-200" %>"
                           data-app--category--form-target="categoryTypeIcon">
                        <% case type %>
                        <% when "expense" %>
                          <%= heroicon "arrow-trending-down", options: { class: "h-5 w-5 text-white" } %>
                        <% when "income" %>
                          <%= heroicon "arrow-trending-up", options: { class: "h-5 w-5 text-white" } %>
                        <% end %>
                      </div>
                      <span class="text-sm font-medium <%= f.object.category_type == type ? "text-gray-900" : "text-gray-700" %>"
                            data-app--category--form-target="categoryTypeText">
                        <%= type.capitalize %>
                      </span>
                    </div>
                  </div>
                </label>
              </div>
            <% end %>
          </div>
          <% if category.errors[:category_type].any? %>
            <p class="form-error"><%= category.errors[:category_type].first %></p>
          <% end %>
        </div>

        <%# WHERE THIS CATEGORY'S MONEY LIVES — required since plan 3 decision 3.
            `categories.pool_id` used to be nullable and a nil was documented as meaning "the user's
            default account", which no reader implemented: `PoolBalanceLedger::ENTRY_POOL_ID`
            resolves `COALESCE(entries.pool_id, categories.pool_id)` to NOTHING, so a pool-less
            category's spending left the pool tree entirely while `Σ pools == your bank balance`
            claimed otherwise. The cutover migration filled every nil with the user's default
            account; this control is how a new one gets an answer instead of a null.

            DEFAULTED TO THE DEFAULT ACCOUNT (CategoriesController#new) rather than to a blank, and
            the default is the honest one: an account IS the buffer (§7.1), so "this spending comes
            out of my buffer" is what a category means before the user has given it an envelope, and
            it is the state the Budget page's rate detector then proposes an envelope for.

            GROUPED BY POOL TYPE, in `Pool::NOUNS`' words rather than the enum's, because those are
            the nouns the rest of the app uses on screen — a user who reads "Envelope" on the
            Categories page should not meet "budget" here.

            NO `include_blank`: the choice is required, and a prompt option that submits an empty
            string would offer the one answer the model refuses. An INCOME category must name an
            account (Category#income_must_land_in_an_account); the list is not filtered by type
            because the type is switched client-side on this same form, and a picker whose options
            changed under the user would be worse than a legible 422. %>
        <% pools_by_noun = current_user.pools.order(:pool_type, :name).group_by { |pool| pool.noun.capitalize } %>
        <div class="mt-5">
          <% if pools_by_noun.any? %>
            <%= f.input :pool_id,
                collection: pools_by_noun,
                as: :grouped_select,
                group_method: :last,
                group_label_method: :first,
                label_method: :name,
                value_method: :id,
                include_blank: false,
                label: "Where this money lives",
                hint: "A buffer is money you simply hold; an envelope or a goal reserves it. You can move this later." %>
          <% else %>
            <%# A USER WITH NO POOLS AT ALL, and the form has to say so rather than offer an empty
                picker. Requiring a pool makes this state reachable for the first time: a brand-new
                account has no pools, nothing in the app creates one for them, and a select with no
                options would submit blank and meet "Pool must exist" with no way to act on it.
                Naming the route is the whole fix — every user needs an account before anything
                else in this app means anything. %>
            <label class="form-label">Where this money lives</label>
            <p class="form-hint" data-no-pools>
              Every category has to say where its money lives, and you have no accounts yet.
            </p>
            <%= link_to "Make an account first", new_pool_path, class: "btn btn-secondary mt-2" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 mb-6">
      <div class="p-6">
        <h2 class="text-xl font-semibold mb-4">Appearance</h2>
        
        <%= f.label :color %>
        
        <div class="mb-4 mt-2">
          <div class="grid grid-cols-8 sm:grid-cols-10 lg:grid-cols-12 gap-3">
            <% ["#C9C78B", "#5F741D", "#4CAF50", "#2EC4B6", "#2196F3", "#03A9F4", "#673AB7", "#9C27B0", "#F44336", "#FF9800", "#FFC107", "#FDCA40", "#455A64", "#212121", "#E2E1C6", "#FDFDFE"].each do |color| %>
              <div>
                <label class="cursor-pointer">
                  <%= f.radio_button :color, 
color, 
                                    class: "sr-only color-radio", 
                                    data: { 
                                      action: "change->app--category--form#selectColor"
                                    } %>
                  <div class="h-10 w-10 rounded-md border-2 transition-all
                            <%= f.object.color == color ? "ring-2 ring-offset-2 ring-gray-700" : "hover:opacity-90" %>"
                       data-color="<%= color %>" 
                       data-app--category--form-target="colorOption"
                       style="background-color: <%= color %>;"></div>
                </label>
              </div>
            <% end %>
          </div>
          
          <div class="mt-3 text-center">
            <span class="inline-flex items-center gap-2">
              <span class="text-sm font-medium text-gray-700">Selected:</span>
              <span 
                class="h-6 w-6 rounded inline-block border"
                data-app--category--form-target="selectedColorPreview"
                style="background-color: <%= f.object.color || "#C9C78B" %>;">
              </span>
              <code class="text-sm bg-gray-100 px-2 py-1 rounded" data-app--category--form-target="selectedColorCode">
                <%= f.object.color || "#C9C78B" %>
              </code>
            </span>
          </div>
        </div>
        
        <%= f.input :color, 
                   label: false, 
                   placeholder: "#C9C78B", 
                   hint: "Enter a valid hex color code (e.g. #C9C78B)", 
                   input_html: { 
                     data: { 
                       "app--category--form-target": "colorInput",
                       action: "input->app--category--form#colorInputChanged"
                     }
                   } %>
      </div>
    </div>

    <%= f.hidden_field :user_id, value: current_user.id if category.new_record? %>

    <%# Form Actions %>
    <div class="flex flex-col sm:flex-row sm:justify-end gap-3">
      <% cancel_path = category.persisted? ? category_path(category) : categories_path %>
      <%= link_to "Cancel",
cancel_path,
          class: "btn btn-secondary" %>

      <%= f.button :submit,
          category.persisted? ? "Update Category" : "Create Category" %>
    </div>
  </div>
<% end %>
