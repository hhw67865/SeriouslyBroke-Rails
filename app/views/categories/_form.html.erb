<%= simple_form_for(category) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div data-controller="app--category--form">
    <div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 mb-6">
      <div class="p-6">
        <h2 class="text-xl font-semibold mb-4">Basic Information</h2>
        
        <%= f.input :name, placeholder: "e.g. Groceries, Salary, Vacation Fund" %>

        <div class="space-y-2 mt-5">
          <%# TWO TYPES, TWO TILES (plan 3, task 5). `Category.category_types` drives the loop, so
              the savings tile disappeared with the enum value; the grid closes at two rather than
              leaving a third of the row empty. %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% Category.category_types.keys.each do |type| %>
              <div>
                <label class="cursor-pointer flex flex-col">
                  <div class="relative">
                    <%= f.radio_button :category_type, 
type, 
                                      class: "sr-only", 
                                      data: { 
                                        action: "change->app--category--form#selectCategoryType"
                                      } %>
                    <div class="w-full border-2 rounded p-4 transition-all flex flex-col items-center category-type-option
                              <%= f.object.category_type == type ? "border-brand bg-brand-light" : "border-gray-200 hover:border-gray-300" %>"
                        data-type="<%= type %>"
                        data-app--category--form-target="categoryTypeOption">
                      <div class="w-10 h-10 rounded-md flex items-center justify-center mb-2 
                                <%= f.object.category_type == type ? "bg-brand" : "bg-gray-200" %>"
                           data-app--category--form-target="categoryTypeIcon">
                        <% case type %>
                        <% when "expense" %>
                          <%= heroicon "arrow-trending-down", options: { class: "h-5 w-5 text-white" } %>
                        <% when "income" %>
                          <%= heroicon "arrow-trending-up", options: { class: "h-5 w-5 text-white" } %>
                        <% end %>
                      </div>
                      <span class="text-sm font-medium <%= f.object.category_type == type ? "text-gray-900" : "text-gray-700" %>"
                            data-app--category--form-target="categoryTypeText">
                        <%= type.capitalize %>
                      </span>
                    </div>
                  </div>
                </label>
              </div>
            <% end %>
          </div>
          <% if category.errors[:category_type].any? %>
            <p class="form-error"><%= category.errors[:category_type].first %></p>
          <% end %>
        </div>

      </div>
    </div>

    <%# WHAT THIS CATEGORY HOLDS (two-ledger spec §3, §4). This block REPLACES the pool picker —
        "Where this money lives", a grouped select over every pool the user owned — which is gone
        with the layer it named: a category holds its own money now, so there is nowhere else for
        it to live and nothing to point at.

        ALL THREE ARE USER-EDITABLE, which §4 requires of `funded_since` and which the two beside
        it have always needed: `priority` was seed data with no writer in the app until the Budget
        page's drag handle, and `target_amount` had no door at all once the savings pool died.

        THEY ARE SHOWN FOR EVERY TYPE, not just expenses, for the reason the pool picker was: the
        type is switched CLIENT-SIDE on this same form, so fields that appeared and vanished under
        the user would be worse than the legible 422 `Category#holding_columns_are_sane` gives for
        a target on an income category. %>
    <div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 mb-6">
      <div class="p-6">
        <h2 class="text-xl font-semibold mb-4">Holding money</h2>

        <p class="text-sm text-gray-500 mb-5" data-holding-intro>
          An expense category holds its own money once it has a funding start. Until then its
          spending comes out of what's available.
        </p>

        <%# THE TARGET, AND THE HINT SAYS WHAT IT SWITCHES OFF. A target does not merely draw a
            progress bar: `HoldingCalculator#saving_toward_a_target?` is the guard on
            `#compute_period_closed`, so a category with one NEVER has its leftover swept back to
            available at the end of a period (Task 3's savings-never-sweep ruling). Setting a
            target on an ordinary funded category therefore turns off use-it-or-lose-it, quietly,
            and a user who is not told that will meet it as a surprise a period later. %>
        <div class="mt-5">
          <%= f.input :target_amount,
              as: :decimal,
              label: "Target",
              input_html: { placeholder: "0.00", step: 0.01, min: 0.01 },
              hint: "The figure you're saving toward. A target makes this a goal — and money " \
                    "here is never swept back to available at the end of a period, so a target " \
                    "switches off use-it-or-lose-it. Leave it blank for an ordinary envelope." %>
        </div>

        <%# THE FILL ORDER. `Category.apply_fill_order` is the Budget page's drag handle and the
            other writer; both write the same column, and it is dense there rather than here — a
            number typed in this box may tie with another category's, and `Category.in_fill_order`
            breaks a tie on NAME. Said plainly rather than left to be discovered. %>
        <div class="mt-5">
          <%= f.input :priority,
              as: :integer,
              label: "Funding priority",
              input_html: { min: 0, step: 1 },
              hint: "Where this category sits when you distribute — lower is funded first. Ties " \
                    "are broken by name. You can also drag the order on the Budget page." %>
        </div>

        <%# THE FUNDING START, AND THE HINT SAYS THAT EDITING IT MOVES HISTORY. It is the date
            `CategoryLedger::ENTRY_CATEGORY_ID` compares every entry against: spending on or after
            it drains THIS category, spending before it drains available. So changing this field
            re-reads spending that is already recorded, in both directions — and clearing it on a
            category that carries a rule drops that category out of `Category.in_fill_order`
            entirely, which the Budget page shows as its "Not in the fill order" band. %>
        <div class="mt-5">
          <%= f.input :funded_since,
              as: :date,
              html5: true,
              label: "Holding since",
              hint: "The day this category started holding its own money. Spending before it " \
                    "reads against what's available instead — so changing this date moves " \
                    "history. Clear it and the category stops holding money and leaves the " \
                    "fill order." %>
        </div>
      </div>
    </div>

    <div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 mb-6">
      <div class="p-6">
        <h2 class="text-xl font-semibold mb-4">Appearance</h2>
        
        <%= f.label :color %>
        
        <div class="mb-4 mt-2">
          <div class="grid grid-cols-8 sm:grid-cols-10 lg:grid-cols-12 gap-3">
            <% ["#C9C78B", "#5F741D", "#4CAF50", "#2EC4B6", "#2196F3", "#03A9F4", "#673AB7", "#9C27B0", "#F44336", "#FF9800", "#FFC107", "#FDCA40", "#455A64", "#212121", "#E2E1C6", "#FDFDFE"].each do |color| %>
              <div>
                <label class="cursor-pointer">
                  <%= f.radio_button :color, 
color, 
                                    class: "sr-only color-radio", 
                                    data: { 
                                      action: "change->app--category--form#selectColor"
                                    } %>
                  <div class="h-10 w-10 rounded-md border-2 transition-all
                            <%= f.object.color == color ? "ring-2 ring-offset-2 ring-gray-700" : "hover:opacity-90" %>"
                       data-color="<%= color %>" 
                       data-app--category--form-target="colorOption"
                       style="background-color: <%= color %>;"></div>
                </label>
              </div>
            <% end %>
          </div>
          
          <div class="mt-3 text-center">
            <span class="inline-flex items-center gap-2">
              <span class="text-sm font-medium text-gray-700">Selected:</span>
              <span 
                class="h-6 w-6 rounded inline-block border"
                data-app--category--form-target="selectedColorPreview"
                style="background-color: <%= f.object.color || "#C9C78B" %>;">
              </span>
              <code class="text-sm bg-gray-100 px-2 py-1 rounded" data-app--category--form-target="selectedColorCode">
                <%= f.object.color || "#C9C78B" %>
              </code>
            </span>
          </div>
        </div>
        
        <%= f.input :color, 
                   label: false, 
                   placeholder: "#C9C78B", 
                   hint: "Enter a valid hex color code (e.g. #C9C78B)", 
                   input_html: { 
                     data: { 
                       "app--category--form-target": "colorInput",
                       action: "input->app--category--form#colorInputChanged"
                     }
                   } %>
      </div>
    </div>

    <%= f.hidden_field :user_id, value: current_user.id if category.new_record? %>

    <%# Form Actions %>
    <div class="flex flex-col sm:flex-row sm:justify-end gap-3">
      <% cancel_path = category.persisted? ? category_path(category) : categories_path %>
      <%= link_to "Cancel",
cancel_path,
          class: "btn btn-secondary" %>

      <%= f.button :submit,
          category.persisted? ? "Update Category" : "Create Category" %>
    </div>
  </div>
<% end %>
