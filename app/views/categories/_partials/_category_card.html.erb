<div class="group cursor-pointer" onclick="window.location='<%= category_path(category) %>'">
  <div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
    <div class="p-5 flex-grow">
      <div class="flex justify-between items-start mb-4">
        <div class="flex items-center">
          <div class="w-10 h-10 rounded-md flex items-center justify-center" style="background-color: <%= category.color || "#C9C78B" %>;">
            <% case category.category_type %>
            <% when "expense" %>
              <%= heroicon "arrow-trending-down", options: { class: "h-5 w-5 text-white" } %>
            <% when "income" %>
              <%= heroicon "arrow-trending-up", options: { class: "h-5 w-5 text-white" } %>
            <% end %>
          </div>
          <div class="ml-3">
            <h3 class="text-lg font-medium text-gray-900"><%= category.name %></h3>
            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset ring-gray-200 mt-1">
              <%= category.category_type.capitalize %>
            </span>
            <% unless category.tracked? %>
              <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium text-gray-400 ring-1 ring-inset ring-gray-200 mt-1 ml-1">
                Untracked
              </span>
            <% end %>
          </div>
        </div>
      </div>
    
    <div class="mt-2">
      <% calc = category.calculator(selected_date) %>
      <%# `expense?` rather than the deleted `pool_covered?`: every expense category points at a
          pool now, so the cap arm that followed this one is unreachable and is deleted with the
          cap (plan 3, task 3). %>
      <% if category.expense? %>
        <div class="mb-4">
          <div class="flex justify-between text-sm mb-1">
            <span class="text-gray-500">Spent <%= period_time_label %></span>
            <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
          </div>
          <p class="text-xs text-gray-500 mt-2">
            Pool: <%= category.pool.name %>
          </p>
        </div>
      <% elsif category.income? %>
        <div class="mb-4">
          <div class="flex justify-between text-sm mb-1">
            <span class="text-gray-500">Monthly Income</span>
            <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
          </div>
          
          <div class="flex justify-between mt-2">
            <span class="text-xs text-gray-500">vs last month</span>
            <span class="text-xs flex items-center gap-1 <%= calc.previous_month_trend == :up ? "text-status-success" : "text-status-danger" %>">
              <%= heroicon calc.previous_month_trend == :up ? "arrow-up" : "arrow-down", options: { class: "h-3 w-3" } %>
              <%= calc.previous_month_change_percentage.abs %>%
            </span>
          </div>
        </div>
      <% end %>
      
      <% if category.items.any? %>
        <div class="mt-4">
          <h4 class="text-sm font-medium text-gray-700 mb-2">Top Items</h4>
          <ul class="space-y-1">
            <% calc.top_items.each do |item, amount| %>
              <li class="flex justify-between text-sm">
                <span class="text-gray-600 truncate max-w-[70%]"><%= item.name %></span>
                <% case category.category_type %>
                <% when "expense" %>
                  <span class="text-status-danger font-medium">-<%= number_to_currency(amount) %></span>
                <% when "income" %>
                  <span class="text-status-success font-medium">+<%= number_to_currency(amount) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 italic">No items yet</p>
      <% end %>
    </div>
  </div>
  
    <%# Hover indicator %>
    <div class="bg-gray-50 px-5 py-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <div class="text-center">
        <span class="text-sm text-gray-500">Click to view details</span>
      </div>
    </div>
  </div>
</div> 