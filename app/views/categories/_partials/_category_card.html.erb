<div class="group cursor-pointer" onclick="window.location='<%= category_path(category) %>'">
  <div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
    <div class="p-5 flex-grow">
      <div class="flex justify-between items-start mb-4">
        <div class="flex items-center">
          <div class="w-10 h-10 rounded-md flex items-center justify-center" style="background-color: <%= category.color || "#C9C78B" %>;">
            <% case category.category_type %>
            <% when "expense" %>
              <%= heroicon "arrow-trending-down", options: { class: "h-5 w-5 text-white" } %>
            <% when "income" %>
              <%= heroicon "arrow-trending-up", options: { class: "h-5 w-5 text-white" } %>
            <% end %>
          </div>
          <div class="ml-3">
            <h3 class="text-lg font-medium text-gray-900"><%= category.name %></h3>
            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset ring-gray-200 mt-1">
              <%= category.category_type.capitalize %>
            </span>
            <% unless category.tracked? %>
              <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium text-gray-400 ring-1 ring-inset ring-gray-200 mt-1 ml-1">
                Untracked
              </span>
            <% end %>
          </div>
        </div>
      </div>
    
    <div class="mt-2">
      <% calc = category.calculator(selected_date) %>
      <%# `expense?` rather than the deleted `pool_covered?`: the cap arm that used to follow this
          one is deleted with the cap it read (plan 3, task 3). %>
      <% if category.expense? %>
        <div class="mb-4">
          <div class="flex justify-between text-sm mb-1">
            <span class="text-gray-500">Spent <%= period_time_label %></span>
            <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
          </div>
          <%# WHAT IT HOLDS, WHERE IT HOLDS ANYTHING (two-ledger spec §3, Task 7). This line read
              "Pool: Checking" — the name of the pool the category pointed at, which under this
              model says nothing about the category at all. `Category#holder?` is the question, and
              a card that is saving toward a figure gets the goal's own bar so the savings the
              Pools index used to list are findable on the screen that replaced it.

              THE GOAL TEST IS `HoldingCalculator#saving_toward_a_target?` (Task 7's ruling), the
              same predicate the show page's holdings card, Home and the entry form's impact card
              ask — so a rule-bearing goal is a goal on every one of them. %>
          <% if category.holder? %>
            <%# `holding_terms` IS THE INDEX'S ONE LEDGER (fix round 1, MED-3) — see
                `CategoriesController#holding_terms`. A nil for a category the ledger does not know
                is legal and means "run your own aggregates", so this can never be wrong for want
                of terms. %>
            <% holdings = category.holding_calculator(terms: holding_terms[category.id]) %>
            <div class="flex justify-between text-xs mt-2" data-holding-line>
              <span class="text-gray-500">Holding</span>
              <span class="font-medium <%= holdings.balance.negative? ? "text-status-danger" : "text-gray-900" %>">
                <%= number_to_currency(holdings.balance) %>
              </span>
            </div>
            <% if holdings.saving_toward_a_target? %>
              <% progress = holdings.progress_percentage %>
              <div class="mt-2" data-goal-progress>
                <div class="h-1.5 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-1.5 rounded-full <%= progress >= 100 ? "bg-status-success" : "bg-brand" %>"
                       style="width: <%= progress %>%;"></div>
                </div>
                <p class="text-xs text-gray-500 mt-1">
                  <%= progress %>% of <%= number_to_currency(category.target_amount) %>
                </p>
              </div>
            <% end %>
          <% else %>
            <p class="text-xs text-gray-500 mt-2" data-holding-line>
              Comes out of what's available
            </p>
          <% end %>
        </div>
      <% elsif category.income? %>
        <div class="mb-4">
          <div class="flex justify-between text-sm mb-1">
            <span class="text-gray-500">Monthly Income</span>
            <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
          </div>
          
          <div class="flex justify-between mt-2">
            <span class="text-xs text-gray-500">vs last month</span>
            <span class="text-xs flex items-center gap-1 <%= calc.previous_month_trend == :up ? "text-status-success" : "text-status-danger" %>">
              <%= heroicon calc.previous_month_trend == :up ? "arrow-up" : "arrow-down", options: { class: "h-3 w-3" } %>
              <%= calc.previous_month_change_percentage.abs %>%
            </span>
          </div>
        </div>
      <% end %>
      
      <% if category.items.any? %>
        <div class="mt-4">
          <h4 class="text-sm font-medium text-gray-700 mb-2">Top Items</h4>
          <ul class="space-y-1">
            <% calc.top_items.each do |item, amount| %>
              <li class="flex justify-between text-sm">
                <span class="text-gray-600 truncate max-w-[70%]"><%= item.name %></span>
                <% case category.category_type %>
                <% when "expense" %>
                  <span class="text-status-danger font-medium">-<%= number_to_currency(amount) %></span>
                <% when "income" %>
                  <span class="text-status-success font-medium">+<%= number_to_currency(amount) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 italic">No items yet</p>
      <% end %>
    </div>
  </div>
  
    <%# Hover indicator %>
    <div class="bg-gray-50 px-5 py-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <div class="text-center">
        <span class="text-sm text-gray-500">Click to view details</span>
      </div>
    </div>
  </div>
</div> 