<!-- Summary Card -->
<div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 p-6">
  <h2 class="text-xl font-semibold mb-4">Summary</h2>

  <% calc = category.calculator(selected_date, period: current_period) %>
  <%# ONE ARM PER CATEGORY TYPE. The cap arm that used to sit between them — a monthly budget bar,
      a pace line and a "No budget set" empty state — was deleted with the cap it read (plan 3,
      task 3). %>
  <% if category.expense? %>
    <!-- Expense Category Summary -->
    <div class="space-y-6">
      <div>
        <div class="flex justify-between text-sm mb-2">
          <span class="text-gray-500">Spent <%= period_time_label %></span>
          <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
        </div>
        <%# WHERE THE SPENDING WENT, IN ONE SENTENCE, AND THE POOL IS OUT OF IT (Task 7). This
            named `category.pool` — "Spending here comes out of the envelope Groceries", linked to
            the pool page — and both halves are gone: the pool screens are deleted and a category
            holds its own money (two-ledger spec §3). The line asks `Category#holder?`, which is
            the one predicate the holdings card in the right-hand column branches on, so the two
            cards on this page cannot say different things about the same category. %>
        <p class="text-xs text-gray-500">
          <% if category.holder? %>
            Spending here comes out of what this category holds
          <% else %>
            Spending here comes out of what's available — nothing reserves it
          <% end %>
        </p>
      </div>

      <div class="border-t border-gray-200 pt-4">
        <h3 class="text-base font-medium mb-3"><%= period_trend_label %> Spending Trend</h3>
        <div class="bg-gray-50 rounded p-4 flex items-center justify-center">
          <%
            spending_data = if current_period == :ytd
                              calculate_running_total(category.entries.group_by_month(:date, range: calc.date_range).sum(:amount))
                            else
                              calculate_running_total(category.entries.group_by_day(:date, range: calc.date_range).sum(:amount))
                            end
          %>
          <%= line_chart [{ name: "Spending", data: spending_data }], curve: false, points: false, colors: [DashboardPresenter::COLORS[:brand]], prefix: "$ " %>
        </div>
      </div>
    </div>

  <% elsif category.income? %>
    <!-- Income Category Summary -->
    <div class="space-y-6">
      <div>
        <div class="flex justify-between text-sm mb-2">
          <span class="text-gray-500"><%= period_amount_label(:income) %></span>
          <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
        </div>

        <% if current_period == :monthly %>
          <div class="flex justify-between mt-4">
            <span class="text-sm text-gray-500">vs last month</span>
            <span class="text-sm flex items-center gap-1 <%= calc.previous_month_trend == :up ? "text-status-success" : "text-status-danger" %>">
              <%= heroicon calc.previous_month_trend == :up ? "arrow-up" : "arrow-down", options: { class: "h-4 w-4" } %>
              <%= calc.previous_month_change_percentage.abs %>%
            </span>
          </div>
        <% end %>
      </div>

      <div class="border-t border-gray-200 pt-4">
        <h3 class="text-base font-medium mb-3">Income <%= current_period == :ytd ? "This Year" : "Trend" %></h3>
        <div class="bg-gray-50 rounded p-4 flex items-center justify-center">
          <%
            income_chart_range = current_period == :ytd ?
              calc.date_range :
              (selected_date.beginning_of_month - 5.months)..selected_date.end_of_month
          %>
          <%= line_chart category.entries.group_by_month(:date, range: income_chart_range).sum(:amount), curve: false, points: false, colors: [DashboardPresenter::COLORS[:brand]], prefix: "$ " %>
        </div>
      </div>
    </div>
    
  <%# THE SAVINGS ARM IS DELETED (plan 3, task 5) — a "Monthly Contribution" figure, a pool box
      saying "This category contributes to a shared goal", and a running-total line drawn by
      `CategoriesHelper#savings_evolution_series` (deleted with it, one reader). There is no savings
      category: money reaches a goal as an `Allocation`, and the category's own page reads it. %>
  <% end %>
</div> 