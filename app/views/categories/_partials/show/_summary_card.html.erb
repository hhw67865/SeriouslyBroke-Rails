<!-- Summary Card -->
<div class="bg-white shadow-sm rounded overflow-hidden border border-gray-100 p-6">
  <h2 class="text-xl font-semibold mb-4">Summary</h2>

  <% calc = category.calculator(selected_date, period: current_period) %>
  <%# EVERY EXPENSE CATEGORY POINTS AT A POOL (plan 3, task 3), so this arm and `expense?` are the
      same set and the cap arm that used to sit between them — a monthly budget bar, a pace line and
      a "No budget set" empty state — is deleted with the cap it read. %>
  <% if category.expense? %>
    <!-- Pool-Covered Expense Category Summary -->
    <div class="space-y-6">
      <div>
        <div class="flex justify-between text-sm mb-2">
          <span class="text-gray-500">Spent <%= period_time_label %></span>
          <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
        </div>
        <%# THE THIRD CARD ON THIS PAGE, AND IT HELD THE SAME DEFECT AS THE OTHER TWO (2d
            whole-plan review, fix 2, found in the visual check). This arm is every EXPENSE
            category — each of which points at some pool — and it said "Funded by savings pool" about
            all of them: about a budget ENVELOPE, which is not a savings pool, and about a savings
            goal this category SPENDS from rather than is funded by. Both halves are now read from
            the pool: `Pool#noun` for the word, and the direction from what an expense category
            actually does to a pool it points at (`PoolBalanceLedger::ENTRY_POOL_ID` subtracts it).
            The trailing clause is true of both kinds — this spending is separate from whatever
            else the user's budget is doing, whichever pool it comes out of. %>
        <p class="text-xs text-gray-500">
          Spending here comes out of the <%= category.pool.noun %>
          <%= link_to category.pool.name, pool_path(category.pool), class: "text-brand hover:text-brand-dark" %>
          — separate from your monthly budget
        </p>
      </div>

      <div class="border-t border-gray-200 pt-4">
        <h3 class="text-base font-medium mb-3"><%= period_trend_label %> Spending Trend</h3>
        <div class="bg-gray-50 rounded p-4 flex items-center justify-center">
          <%
            spending_data = if current_period == :ytd
                              calculate_running_total(category.entries.group_by_month(:date, range: calc.date_range).sum(:amount))
                            else
                              calculate_running_total(category.entries.group_by_day(:date, range: calc.date_range).sum(:amount))
                            end
          %>
          <%= line_chart [{ name: "Spending", data: spending_data }], curve: false, points: false, colors: [DashboardPresenter::COLORS[:brand]], prefix: "$ " %>
        </div>
      </div>
    </div>

  <% elsif category.income? %>
    <!-- Income Category Summary -->
    <div class="space-y-6">
      <div>
        <div class="flex justify-between text-sm mb-2">
          <span class="text-gray-500"><%= period_amount_label(:income) %></span>
          <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
        </div>

        <% if current_period == :monthly %>
          <div class="flex justify-between mt-4">
            <span class="text-sm text-gray-500">vs last month</span>
            <span class="text-sm flex items-center gap-1 <%= calc.previous_month_trend == :up ? "text-status-success" : "text-status-danger" %>">
              <%= heroicon calc.previous_month_trend == :up ? "arrow-up" : "arrow-down", options: { class: "h-4 w-4" } %>
              <%= calc.previous_month_change_percentage.abs %>%
            </span>
          </div>
        <% end %>
      </div>

      <div class="border-t border-gray-200 pt-4">
        <h3 class="text-base font-medium mb-3">Income <%= current_period == :ytd ? "This Year" : "Trend" %></h3>
        <div class="bg-gray-50 rounded p-4 flex items-center justify-center">
          <%
            income_chart_range = current_period == :ytd ?
              calc.date_range :
              (selected_date.beginning_of_month - 5.months)..selected_date.end_of_month
          %>
          <%= line_chart category.entries.group_by_month(:date, range: income_chart_range).sum(:amount), curve: false, points: false, colors: [DashboardPresenter::COLORS[:brand]], prefix: "$ " %>
        </div>
      </div>
    </div>
    
  <% elsif category.savings? %>
    <!-- Savings Category Summary -->
    <div class="space-y-6">
      <div>
        <div class="flex justify-between text-sm mb-2">
          <span class="text-gray-500"><%= period_amount_label(:savings) %></span>
          <span class="font-medium text-gray-900"><%= number_to_currency(calc.total_amount) %></span>
        </div>
        
        <% if category.pool.present? %>
          <div class="mt-4 p-4 rounded bg-gray-50 border border-gray-200">
            <div class="flex justify-between items-start">
              <%# `Pool#noun` AND THE POOL CARD'S OWN SENTENCE (2d whole-plan review, fix 2). This
                  box sits on the same page as the pool card, about the same pool, and said
                  "Savings Pool" where that card now says "Goal" — the two-nouns-one-page defect
                  moved rather than fixed. A savings category really does contribute, so this arm
                  keeps that verb; the pool card's own savings arm is where the other direction
                  lives. %>
              <div>
                <h4 class="text-sm font-medium text-gray-700"><%= category.pool.noun.capitalize %></h4>
                <p class="text-base font-medium mt-1"><%= category.pool.name %></p>
                <p class="text-xs text-gray-500 mt-1">This category contributes to a shared goal</p>
              </div>
              
              <div class="text-right">
                <%= link_to pool_path(category.pool), class: "text-sm text-brand hover:text-brand-dark flex items-center" do %>
                  <span>View details</span>
                  <%= heroicon "arrow-right", options: { class: "h-3.5 w-3.5 ml-1" } %>
                <% end %>
              </div>
            </div>
            
            <% if category.pool.target_amount.present? && category.pool.target_amount.positive? %>
              <%# ONE CALCULATOR FOR BOTH FIGURES. This built two and read a third inline — three
                  objects, five ledger aggregates each, for two numbers about one pool; the local
                  holding the balance was then never used and the balance beside it was re-read
                  from a fresh calculator on the next line. Two objects for one balance is how two
                  figures on one page come to disagree, and here it was also just cost. %>
              <% calculator = category.pool.calculator %>
              <% progress = calculator.progress_percentage %>
              <div class="mt-3">
                <div class="flex justify-between text-xs text-gray-500 mb-1">
                  <span>Pool progress</span>
                  <span><%= number_to_currency(calculator.current_balance) %> / <%= number_to_currency(category.pool.target_amount) %></span>
                </div>
                <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-2 rounded-full
                       <%= if progress >= 100
                             'bg-status-success'
                           elsif progress < 0
                             'bg-status-danger'
                           else
                             'bg-brand'
                           end %>"
                       style="width: <%= progress %>%;"></div>
                </div>
                <p class="text-xs text-gray-500 mt-1">
                  <% if progress.negative? %>
                    <span class="text-status-danger font-medium"><%= progress %>% of target</span>
                  <% else %>
                    <%= progress %>% of target
                  <% end %>
                </p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      
      <div class="border-t border-gray-200 pt-4">
        <h3 class="text-base font-medium mb-3">Savings <%= current_period == :ytd ? "This Year" : "Progress" %></h3>
        <div class="bg-gray-50 rounded p-4 flex items-center justify-center">
          <%
            savings_chart_range = current_period == :ytd ?
              calc.date_range :
              (selected_date.beginning_of_month - 5.months)..selected_date.end_of_month
          %>
          <%= line_chart savings_evolution_series(category, savings_chart_range), curve: false, points: false, colors: [DashboardPresenter::COLORS[:brand_dark]], prefix: "$ " %>
        </div>
      </div>
    </div>
  <% end %>
</div> 